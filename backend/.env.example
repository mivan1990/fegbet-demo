# Copiaza in `.env` si completeaza. `.env` NU intra in git.

# Secret pentru semnarea JWT. Minim 32 de caractere.
# Genereaza cu:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genereaza_un_string_random_de_minim_32_caractere

# Domeniul de email acceptat la inregistrare. NU se comunica nicaieri in UI.
ALLOWED_EMAIL_DOMAIN=@mariusivan.ro

# Adminii, creati/promovati automat la fiecare pornire daca nu exista.
# Emailurile impartite prin virgula au deja un default bun in cod
# (admin@mariusivan.ro) — de obicei NU trebuie setat aici.
# Suprascrie doar daca vrei alte conturi decat cele doua din cod.
# ADMIN_EMAILS=admin@mariusivan.ro

# Parola initiala pentru adminii de mai sus. Se foloseste DOAR la crearea
# contului — daca un admin isi schimba parola din aplicatie, o repornire nu
# i-o mai reseteaza. Obligatoriu de completat inainte de prima pornire.
ADMIN_PASSWORD=schimba_parola_asta_imediat

# Numele aplicatiei (afisat in UI si pe bilete).
APP_NAME=FEG BET

# Origini CORS permise, separate prin virgula. GOL in productie (acelasi origin).
CORS_ORIGINS=

# Baza de date SQLite. ATENTIE: o cale relativa (./fegbet.db) se rezolva fata de
# directorul din care PORNESTE procesul, nu fata de backend/. Daca pornesti
# uvicorn de altundeva, ajungi pe alta baza, goala. Lasa linia comentata ca sa
# se foloseasca default-ul din cod, care e absolut, sau pune tu o cale absoluta.
# DATABASE_URL=sqlite:////cale/absoluta/catre/fegbet.db
